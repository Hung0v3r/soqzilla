<?xml version="1.0" encoding="utf-8"?>
<!-- The wallet never leaves the phone except through the backup code -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
